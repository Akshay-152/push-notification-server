# ---------------------------------------------------------------------------
# Web Push System - environment configuration (PLACEHOLDERS ONLY)
# Copy to .env and fill in real values. NEVER commit the real .env file.
# ---------------------------------------------------------------------------

# Port the app listens on (behind a reverse proxy this stays local)
PORT=3000

# Public origin of this website, used for URL validation, redirects and
# documentation links. Must match the origin users browse the site with.
SITE_URL=https://example.com

# Secret used to sign session cookies and CSRF material.
# Generate with:  node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
SESSION_SECRET=replace-with-a-long-random-secret

# VAPID keys - generate with:  npm run generate:vapid
# The public key is served to browsers; the private key NEVER leaves the server.
VAPID_PUBLIC_KEY=replace-with-vapid-public-key
VAPID_PRIVATE_KEY=replace-with-vapid-private-key

# VAPID subject: contact address for push services (mailto: or https: URL)
VAPID_SUBJECT=mailto:admin@example.com

# --- Database ---------------------------------------------------------------
# SQLite database file path (relative or absolute). The schema uses portable
# SQL so a migration to PostgreSQL only requires swapping the driver + DSN.
DATABASE_PATH=./data/app.sqlite

# --- Sessions ---------------------------------------------------------------
# Session lifetime in seconds (default 86400 = 24h)
SESSION_TTL_SECONDS=86400

# Set to 1 when served over HTTPS (enables the Secure cookie flag).
# Leave unset/0 for plain http://localhost development.
COOKIE_SECURE=0

# --- Push delivery tuning ---------------------------------------------------
# Max concurrent push sends, max retries per subscription, base backoff (ms)
PUSH_CONCURRENCY=8
PUSH_MAX_RETRIES=3
PUSH_RETRY_BASE_MS=500

# --- Login rate limiting ----------------------------------------------------
# Max failed logins per IP+username window, and window length in seconds
LOGIN_RATE_LIMIT_MAX=10
LOGIN_RATE_LIMIT_WINDOW_SECONDS=900

# --- First admin (used only by `npm run create:admin`) ----------------------
# Prefer interactive input: `npm run create:admin` without these set.
# ADMIN_USERNAME=
# ADMIN_PASSWORD=
